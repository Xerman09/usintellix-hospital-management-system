APP_NAME="Intellix Hospital Management System"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/usintellix-hospital-management-system

# Database Configuration (Kept server-side only)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=usintellix_hospital_management_system
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# SMTP Mail Server Credentials (Kept server-side only)
MAIL_HOST=mail.usintellix.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=iask@usintellix.com
MAIL_PASSWORD=
MAIL_FROM_NAME="Intellix Hospital System"

# Messaging & WhatsApp Gateway (Zenzap API Credentials - Kept server-side only)
ZENZAP_BASE_URL=https://api.zenzap.co
ZENZAP_API_KEY=
ZENZAP_API_SECRET=

# SMS Gateway Integration (Kept server-side only)
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
SMS_GATEWAY_API_KEY=
